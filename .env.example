# Copy to .env and fill in. .env is gitignored.

# Required. https://aistudio.google.com/apikey
# One key does both jobs: judging the player's photos, and generating the
# stage art with `npm run art`.
GEMINI_API_KEY=

# Optional. Leave blank for no access gate (what you want locally).
# Set it on Render so a public URL can't spend your quota — photo judging costs
# more per play than a text turn does.
ACCESS_CODE=

# Optional analytics. Unset means the client sends nothing, so local play is
# never instrumented. A PostHog project key is a public write key, so shipping
# it to the browser is fine — it lives in env so this repo stays free of it.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# How long the player gets to find the object and shoot it. Default 15.
SHOT_SECONDS=15

# Optional abuse guards. Defaults shown.
RUNS_PER_IP_PER_HOUR=5
RUNS_PER_DAY=250
PHOTOS_PER_RUN=40
MAX_IMAGE_BYTES=716800

# Optional. Defaults to 5173.
PORT=5173
